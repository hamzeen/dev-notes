    "file": "javascript.md",
    "category": "Frontend",
    "keywords": [
      "Closures",
      "closure",
      "scope",
      "closures",
      "function",
      "that",
      "remembers",
      "variables",
      "from",
      "lexical",
      "even",
      "after",
